<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="musicFactory.MainMenuController">
   <top>
      <Label text="Music Factory" BorderPane.alignment="CENTER">
         <font>
            <Font size="40.0" />
         </font>
      </Label>
   </top>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="mainMenuButtonPlay" mnemonicParsing="false" onAction="#mainMenuStartGame" prefHeight="50.0" prefWidth="250.0" text="Play">
               <font>
                  <Font size="25.0" />
               </font>
            </Button>
            <Button fx:id="mainMenuButtonQuit" mnemonicParsing="false" onAction="#mainMenuQuitGame" prefHeight="50.0" prefWidth="250.0" text="Quit">
               <font>
                  <Font size="25.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </center>
</BorderPane>
